@page "/invoices/{Id:int}"
@rendermode InteractiveServer
@inject IInvoiceService InvoiceService
@inject INfseService NfseService
@inject NavigationManager Navigation

<PageTitle>@T("Invoice Details")</PageTitle>

@if (notFound)
{
    <p>@T("Invoice not found.")</p>
    <a class="btn btn-secondary" href="/invoices">@T("Back to Invoices")</a>
}
else if (report is null)
{
    <p>@T("Loading...")</p>
}
else
{
    <div class="page-header">
        <div>
            <h1>@report.Invoice.InvoiceNumber</h1>
            <p>@report.Invoice.ClientName · <StatusBadge Status="report.Invoice.Status" /></p>
        </div>
        <div class="actions-row">
            <a class="btn btn-primary" href="/api/invoices/@Id/pdf" target="_blank">@T("Export PDF")</a>
            <button class="btn btn-secondary" @onclick="SavePdfAsync">@T("Save PDF to Folder")</button>
        </div>
    </div>

    <InvoiceActions Invoice="report.Invoice" OnChanged="OnChangedAsync" OnDeleted="OnDeleted" />

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <p class="message @(isError ? "message-error" : null)">@message</p>
    }

    @if (!string.IsNullOrWhiteSpace(warning))
    {
        <p class="message message-warning">@warning</p>
    }

    <section class="nfse-section">
        <div class="page-header">
            <h2>NFS-e</h2>
            @if (report.Invoice.Status != InvoiceStatus.Cancelled)
            {
                <div class="actions-row">
                    @if (!nfses.Any(n => n.Status is NfseStatus.Draft or NfseStatus.Issued))
                    {
                        <button class="btn btn-secondary" data-action="create-nfse" @onclick="CreateNfseAsync">@T("Create NFS-e Draft")</button>
                    }
                    <a class="btn btn-secondary" href="/nfse/import?invoiceId=@Id" data-action="import-nfse">@T("Import XML")</a>
                </div>
            }
        </div>
        @if (nfses.Count == 0)
        {
            <p class="hint">@T("No NFS-e linked to this invoice yet.")@(report.Invoice.Status == InvoiceStatus.Paid ? "" : " " + T("A draft is created automatically when the invoice is marked as paid."))</p>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr><th>@T("Number")</th><th>@T("Issued")</th><th>@T("Amount (BRL)")</th><th>@T("Rate")</th><th>@T("Status")</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var nfse in nfses)
                    {
                        <tr class="nfse-row">
                            <td>@NfseLabels.Number(nfse)</td>
                            <td>@(nfse.IssuedAt?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td>@NfseLabels.Brl(nfse.AmountBrl)</td>
                            <td>@(nfse.AmountBrl > 0 && report.Invoice.Total > 0 ? (nfse.AmountBrl / report.Invoice.Total).ToString("0.0000") : "—")</td>
                            <td><NfseStatusBadge Status="nfse.Status" /></td>
                            <td><a class="btn btn-secondary" href="/nfse/@nfse.Id">@(nfse.Status == NfseStatus.Draft ? T("Edit") : T("View"))</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(report.Invoice.PdfPath))
    {
        <p class="hint">@T("Saved at: {0}", report.Invoice.PdfPath)</p>
    }

    <InvoiceReportView Model="report" />
}

@code {
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromQuery] public string? Saved { get; set; }

    private InvoiceReportModel? report;
    private List<Nfse> nfses = [];
    private bool notFound;
    private bool isError;
    private string? message;
    private string? warning;

    protected override async Task OnParametersSetAsync()
    {
        report = await InvoiceService.GetReportModelAsync(Id);
        notFound = report is null;
        nfses = await NfseService.GetForInvoiceAsync(Id);
        if (Saved is not null && message is null)
            message = Saved;
    }

    private async Task SavePdfAsync()
    {
        warning = null;
        try
        {
            var path = await InvoiceService.SavePdfToDiskAsync(Id);
            isError = false;
            message = T("PDF saved to {0}", path);
            report = await InvoiceService.GetReportModelAsync(Id);
        }
        catch (Exception ex)
        {
            isError = true;
            message = T("Failed to save PDF: {0}", ex.Message);
        }
    }

    private async Task OnChangedAsync(InvoiceActionResult result)
    {
        isError = !result.Success;
        message = result.Message;
        warning = result.Warning;
        report = await InvoiceService.GetReportModelAsync(Id);
        nfses = await NfseService.GetForInvoiceAsync(Id);
    }

    private async Task CreateNfseAsync()
    {
        var result = await NfseService.CreateDraftForInvoiceAsync(Id);
        if (result.Success && result.NfseId is int nfseId)
        {
            Navigation.NavigateTo($"/nfse/{nfseId}?message={Uri.EscapeDataString(result.Message)}");
            return;
        }

        isError = true;
        message = result.Message;
    }

    private void OnDeleted(InvoiceActionResult result)
    {
        Navigation.NavigateTo("/invoices");
    }
}
