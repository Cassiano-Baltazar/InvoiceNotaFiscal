@page "/invoices/{Id:int}/edit"
@rendermode InteractiveServer
@inject IInvoiceService InvoiceService
@inject NavigationManager Navigation

<PageTitle>@T("Edit Invoice")</PageTitle>

@if (invoice is null)
{
    <p>@(loaded ? T("Invoice not found.") : T("Loading..."))</p>
}
else if (!InvoiceRules.CanEdit(invoice.Status))
{
    <h1>@invoice.InvoiceNumber</h1>
    <p class="message message-error">@T("A {0} invoice cannot be edited.", InvoiceRules.GetLabel(invoice.Status).ToLowerInvariant())</p>
    <a class="btn btn-secondary" href="/invoices/@Id">@T("Back to Invoice")</a>
}
else
{
    <h1>@T("Edit {0}", invoice.InvoiceNumber)</h1>
    <p>@invoice.ClientName · <StatusBadge Status="invoice.Status" /></p>

    @if (invoice.Status == InvoiceStatus.Sent)
    {
        <p class="message message-warning">@T("This invoice was already sent. Saving changes will set it back to Not Sent.")</p>
    }

    <EditForm Model="model" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-grid">
            <div class="form-field">
                <label>@T("Invoice Date")</label>
                <InputDate @bind-Value="model.InvoiceDate" class="input" />
            </div>
            <div class="form-field">
                <label>@T("Due Date")</label>
                <InputDate @bind-Value="model.DueDate" class="input" />
            </div>
            <div class="form-field">
                <label>@T("Currency")</label>
                <InputText @bind-Value="model.Currency" class="input" />
            </div>
            <div class="form-field">
                <label>@T("Currency Label")</label>
                <InputText @bind-Value="model.CurrencyLabel" class="input" />
            </div>
            <div class="form-field full-width">
                <label>@T("Wise Payment Link")</label>
                <InputText @bind-Value="model.WisePaymentLink" class="input" />
            </div>
        </div>

        <InvoiceItemsEditor Model="model" />

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <p class="message message-error">@error</p>
        }

        <div class="actions-row">
            <button class="btn btn-primary" type="submit" disabled="@isSaving">@T("Save")</button>
            <a class="btn btn-secondary" href="/invoices/@Id">@T("Back")</a>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int Id { get; set; }

    private Invoice? invoice;
    private InvoiceEditModel model = new();
    private bool loaded;
    private bool isSaving;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        invoice = await InvoiceService.GetInvoiceAsync(Id);
        if (invoice is not null)
            model = InvoiceEditModel.FromInvoice(invoice);
        loaded = true;
    }

    private async Task SaveAsync()
    {
        isSaving = true;
        error = null;
        try
        {
            var result = await InvoiceService.UpdateAsync(Id, model);
            if (!result.Success)
            {
                error = result.Message;
                return;
            }

            var text = string.IsNullOrWhiteSpace(result.Warning) ? result.Message : $"{result.Message} {result.Warning}";
            Navigation.NavigateTo($"/invoices/{Id}?saved={Uri.EscapeDataString(text)}");
        }
        finally
        {
            isSaving = false;
        }
    }
}
