@page "/nfse"
@rendermode InteractiveServer
@inject INfseService NfseService

<PageTitle>NFS-e</PageTitle>

<div class="page-header">
    <h1>NFS-e</h1>
    <div class="actions-row">
        <a class="btn btn-secondary" href="/nfse/new">@T("New Draft")</a>
        <a class="btn btn-primary" href="/nfse/import">@T("Import XML")</a>
    </div>
</div>

<div class="filters narrow-filters">
    <div class="form-field">
        <label>@T("Status")</label>
        <select class="input" @bind="filterStatus" @bind:after="LoadAsync">
            <option value="">@T("All")</option>
            @foreach (var status in Enum.GetValues<NfseStatus>())
            {
                <option value="@status">@NfseLabels.Status(status)</option>
            }
        </select>
    </div>
</div>

@if (nfses is null)
{
    <p>@T("Loading...")</p>
}
else if (nfses.Count == 0)
{
    <p>@(string.IsNullOrEmpty(filterStatus) ? T("No NFS-e yet.") : T("No NFS-e with this status yet.")) @T("Import the XML files downloaded from the city hall portal, or mark an invoice as paid to create a draft.")</p>
}
else
{
    <table class="data-table">
        <thead>
            <tr>
                <th>@T("Number")</th>
                <th>@T("Issued")</th>
                <th>@T("Taker")</th>
                <th>@T("Invoice")</th>
                <th>@T("Amount (BRL)")</th>
                <th>@T("Rate")</th>
                <th>@T("Status")</th>
                <th>@T("Source")</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var nfse in nfses)
            {
                <tr>
                    <td>@NfseLabels.Number(nfse)</td>
                    <td>@(nfse.IssuedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                    <td>@nfse.TakerName</td>
                    <td><a href="/invoices/@nfse.InvoiceId">@nfse.Invoice.InvoiceNumber</a></td>
                    <td>@NfseLabels.Brl(nfse.AmountBrl)</td>
                    <td>@(NfseLabels.ExchangeRate(nfse)?.ToString("0.0000") ?? "—")</td>
                    <td><NfseStatusBadge Status="nfse.Status" /></td>
                    <td>@NfseLabels.Source(nfse.Source)</td>
                    <td><a class="btn btn-secondary" href="/nfse/@nfse.Id">@(nfse.Status == NfseStatus.Draft ? T("Edit") : T("View"))</a></td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="4"><strong>@T("Total issued")</strong></td>
                <td><strong>@NfseLabels.Brl(nfses.Where(x => x.Status == NfseStatus.Issued).Sum(x => x.AmountBrl))</strong></td>
                <td colspan="4"></td>
            </tr>
        </tfoot>
    </table>
}

@code {
    private List<Nfse>? nfses;
    // Issued notes are the ones that count, so the list opens with them.
    private string? filterStatus = nameof(NfseStatus.Issued);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        NfseStatus? status = Enum.TryParse<NfseStatus>(filterStatus, out var parsed) ? parsed : null;
        nfses = await NfseService.GetAllAsync(status);
    }
}
