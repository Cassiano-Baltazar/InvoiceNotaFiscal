@page "/clients"
@rendermode InteractiveServer
@inject IClientService ClientService
@inject NavigationManager Navigation

<PageTitle>@T("Clients")</PageTitle>

<div class="page-header">
    <h1>@T("Clients")</h1>
    <a class="btn btn-primary" href="/clients/new">@T("New Client")</a>
</div>

@if (clients is null)
{
    <p>@T("Loading...")</p>
}
else if (clients.Count == 0)
{
    <p>@T("No clients registered yet.")</p>
}
else
{
    <table class="data-table">
        <thead>
            <tr>
                <th>@T("Name")</th>
                <th>@T("Country")</th>
                <th>@T("Currency")</th>
                <th>@T("Monthly Amount")</th>
                <th>@T("Status")</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var client in clients)
            {
                <tr>
                    <td>@client.Name</td>
                    <td>@client.Country</td>
                    <td>@client.Currency</td>
                    <td>@client.MonthlyAmount.ToString("N2")</td>
                    <td>@(client.IsActive ? T("Active") : T("Inactive"))</td>
                    <td><a href="/clients/@client.Id">@T("Edit")</a></td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Client>? clients;

    protected override async Task OnInitializedAsync()
    {
        clients = await ClientService.GetAllAsync();
    }
}
